# RimeRx Environment Variables Template
# Copy this file to .env for local development or set these variables in your Render Dashboard.

# API Keys
RIME_API_KEY="your_rime_api_key_here"
RIME_URL="https://users.rime.ai/v1/rime-tts"
OPENAI_API_KEY="your_openai_api_key_here"
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# Server Settings (Render populates PORT automatically)
PORT=8000
HOST="0.0.0.0"
